# Copiar para .env.local (desenvolvimento) ou definir no alojamento (produção).

# URL pública do site (sitemap e metadados)
NEXT_PUBLIC_SITE_URL=https://impaxo.com.br

# Formulário de contato — envio por e-mail via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@impaxo.com.br
# Remetente num domínio verificado na Resend
CONTACT_FROM_EMAIL="Site Impaxo <site@impaxo.com.br>"
